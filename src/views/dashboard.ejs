<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= user.name %></p>
    <p>Username: <%= user.email %></p>
    
    <% if (user.role_name === 'admin') { %>
    <div class="admin-controls" style="margin-top: 20px; padding: 15px; background-color: #fff3cd; border: 1px solid #ffeeba;">
        <h3>Administrative Controls</h3>
        <p><a href="/users" class="btn btn-primary">Manage Registered Users</a></p>
    </div>
    <% } %>

    <!-- ============================================================ -->
    <!-- MY VOLUNTEER PROJECTS LIST SECTION                           -->
    <!-- ============================================================ -->
    <section class="my-volunteer-projects" style="margin-top: 30px;">
        <h2>Your Volunteered Projects</h2>

        <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
            <ul style="list-style: none; padding: 0;">
                <% volunteeredProjects.forEach(project => { %>
                    <% 
                       const projectDate = new Date(project.date).toLocaleDateString('en-US', {
                           year: 'numeric',
                           month: 'short',
                           day: 'numeric'
                       });
                    %>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding: 15px; margin-bottom: 10px; background-color: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 4px;">
                        <div>
                            <strong style="font-size: 1.1em;">
                                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            </strong>
                            <div style="color: #666; font-size: 0.9em; margin-top: 4px;">
                                📅 <%= projectDate %> | 📍 <%= project.location %>
                            </div>
                        </div>
                        
                        <!-- Inline cancellation form targeting your unvolunteer route -->
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" style="margin: 0;">
                            <button type="submit" style="background-color: #d32f2f; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 0.9em;">
                                Cancel Sign-Up
                            </button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p style="color: #666; font-style: italic;">You haven't volunteered for any service projects yet.</p>
            <p><a href="/projects" style="color: #1976d2; font-weight: bold;">Browse projects and get involved!</a></p>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
