<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- <link rel="stylesheet" href="/css/main.css"> -->
    <link rel="stylesheet" href="/css/main.css?v=3">

</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizationss</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>
            <% if (!isLoggedIn) { %>
                <li><a href="/register">Register</a></li>
                <li><a href="/login">Login</a></li>
            <% } else { %>
                <li><a href="/logout">Logout</a></li>
            <% } %>
        </ul>
    </nav>
    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            
                <% messages[type].forEach(msg => { %>
                    <div class="alert <%= type %>">
                         <%= msg %>
                    </div>
                <% }); %>
            
        <% } %>
    <% }); %>

    <!-- ============================================================ -->
    <!-- AUTOMATIC FLASH MESSAGE DISMISSAL SCRIPT                    -->
    <!-- ============================================================ -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Target all rendered alert message elements
            const alerts = document.querySelectorAll('.alert');
            
            alerts.forEach((alert) => {
                // Wait 2500ms (2.5 seconds) before starting the fade
                setTimeout(() => {
                    // Apply inline style transitions for a smooth animation
                    alert.style.transition = 'opacity 0.6s ease, transform 0.6s ease, max-height 0.6s ease, padding 0.6s ease, margin 0.6s ease';
                    alert.style.opacity = '0';
                    alert.style.transform = 'translateY(-20px)';
                    
                    // Collapse the physical layout height so content underneath slides up cleanly
                    alert.style.maxHeight = '0px';
                    alert.style.paddingTop = '0px';
                    alert.style.paddingBottom = '0px';
                    alert.style.marginTop = '0px';
                    alert.style.marginBottom = '0px';
                    alert.style.overflow = 'hidden';

                    // Permanently wipe the element from the DOM once animations wrap up
                    setTimeout(() => alert.remove(), 600);
                }, 2500);
            });
        });
    </script>
