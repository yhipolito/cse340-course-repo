<%- include('partials/header') %>

<main>
    <h1>System Directory: Registered Accounts</h1>
    <p><a href="/dashboard">◀ Return to Dashboard</a></p>

    <table class="user-directory-table" border="1" style="width:100%; text-align:left; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th style="padding: 10px;">Full Name</th>
                <th style="padding: 10px;">Email (Username)</th>
                <th style="padding: 10px;">Assigned Role</th>
            </tr>
        </thead>
        <tbody>
            <% if (users && users.length > 0) { %>
                <% users.forEach(account => { %>
                    <tr>
                        <td style="padding: 10px;"><%= account.name %></td>
                        <td style="padding: 10px;"><%= account.email %></td>
                        <td style="padding: 10px;">
                            <span class="role-badge"><%= account.role_name %></span>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="3" style="padding: 10px; text-align: center;">No registered users found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>

<%- include('partials/footer') %>
