<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

  <form action="/edit-project/<%= project.project_id %>" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= project.title %>"
        maxlength="150"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
      ><%= project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= project.location %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="date">Project Date</label>
      <% const isoDate = project.date ? new Date(project.date).toISOString().split('T')[0] : ''; %>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= isoDate %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Partner Organization</label>
      <select id="organizationId" name="organizationId" required>
        <option value="">-- Select an Organization --</option>
        <% organizations.forEach(org => { %>
          <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>><%= org.name %></option>
        <% }); %>
      </select>
    </div>

    <button type="submit">Update Project</button>
  </form>

</main>
<%- include('partials/footer') %>
